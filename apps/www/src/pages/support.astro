---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, SELF_HOST_GUIDE_PATH } from "../site";

const starsLabel = await githubStarsLabel();
---

<BaseLayout title="Support · RunTars" description="Get help with the RunTars app and self-hosted RunTars.">
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy">
      <h1>RunTars support</h1>
      <p>
        For help with RunTars or a hosted RunTars account, email{" "}
        <a href="mailto:support@runtars.com">support@runtars.com</a>. Include the email address on your
        account, what you expected to happen, and any error message you saw. Do not send passwords, API keys,
        access tokens, or other secrets.
      </p>
      <h2>Self-hosted RunTars</h2>
      <p>
        Start with the <a href={SELF_HOST_GUIDE_PATH}>self-hosting guide</a>. For reproducible bugs or feature requests,
        open an issue in the <a href={`${GITHUB_URL}/issues`}>RunTars GitHub repository</a>.
      </p>
      <h2 id="account-deletion">Account deletion</h2>
      <p>
        Sign in at{" "}
        <a href="https://app.runtars.com">app.runtars.com</a> and delete your account under{" "}
        <strong>Settings</strong> → <strong>Account</strong>. This permanently deletes the hosted account and its
        associated personal Space data.
      </p>
      <p>
        Without access to the app, email <a href="mailto:support@runtars.com">support@runtars.com</a> from your account's
        email address to ask us to delete it. Sign-in security records are kept for up to 90 days.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
